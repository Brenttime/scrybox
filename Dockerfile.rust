# =========================================
# Scrybox — Node-free Rust image (LANE B unit 7)
#
# Single binary, glibc Debian. No Node runtime anywhere in the final image
# (Gate D: "the single-binary Docker image (no Node)"). The Node image stays
# the parity oracle; this one is what the Rust lane ships.
#
# Build via server/docker/build-rust-image.sh — it stages the binary
# (cargo build --release, offloaded to brain via tools/remote-cargo), the
# ONNX Runtime dylib and the scryjpeg shim into server/docker/{bin,lib}/
# first. The frontend bundle is still built in Stage 1 with node:alpine —
# a build-time tool, gone from the final layers.
#
# Size design (lane-B iter-50; Gate D ceiling: image < 150 MB uncompressed,
# the `docker image inspect -f '{{.Size}}'` number build-rust-image.sh
# prints). debian:12-slim alone is 116 MB, and a root `chown -R` over the
# payload re-commits every byte it touches (the old final stage carried a
# 61 MB ghost layer of duplicated ORT + dist bytes). So the final stage is
# FROM scratch: stage 2 is a debian:12-slim *package donor* whose only
# export is /staging — the ldd closure of every exec'd/dlopen'd binary plus
# gosu, busybox-static and the CA roots — and scratch receives just those
# files, with payload ownership baked in via COPY --chown (never chown -R).
#
# Payload budget (uncompressed): server 17.6 (+~2 MB: linked local-scryfall
# engine) + scryfall portal/meta 0.7 + ORT 38 + scryjpeg 0.2 +
# curl-impersonate 4.9 (stripped: the published binary carries full debug
# symbols, 30.8 -> 4.9 MB, same behaviour) + dist 22.5 + shared 0.2 +
# glibc/libstdc++/libgcc closure ~11 + static gosu 2.9 + busybox 2.5 +
# CA roots ~1.3 ≈ 101 MB.
#
#   docker build -f Dockerfile.rust -t scrybox-rust:local .
# =========================================

# =========================================
# Stage 1: Build Frontend Assets (build-time Node only)
# =========================================
FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
# Shared JSON tables imported via ../../../shared/*.json (resolves to /app/shared)
COPY shared/ /app/shared/
RUN npm run build

# =========================================
# Stage 2: package donor (discarded — only /staging is COPY'd out)
# =========================================
FROM debian:12-slim AS pkgroot
# glibc Debian, same distro family the Node image runs (issue #19): the ONNX
# Runtime dylib and libscryjpeg are glibc-linked and the server binary is
# built against Debian glibc. Nothing apt installs here survives into the
# final image — only the explicit ldd closure below is copied out.
#   gosu            — entrypoint privilege drop (Gate D requirement), static
#   busybox-static  — sh/find/chown/mkdir/echo for the entrypoint + wget for
#                     HEALTHCHECK (replaces the slim-distro wget, -9 MB apt)
#   ca-certificates — HTTPS to the card APIs (rustls-native-certs reads this)
#   binutils+wget   — build tools for curl-impersonate staging, stay in donor
RUN apt-get update && apt-get install -y --no-install-recommends \
      gosu busybox-static ca-certificates binutils wget \
  && rm -rf /var/lib/apt/lists/*

# curl-impersonate v2.1.0 (glibc build), pinned — Gate D requirement, and the
# Moxfield sync genuinely needs the Chrome ClientHello (Cloudflare JA3).
# backend/src/moxfieldApi.js and src/moxfield_api.rs both exec
# /usr/local/bin/curl-impersonate and fall back to plain curl. The published
# binary ships full debug symbols; strip --strip-all keeps behaviour identical
# (verified: --version + a live decklist pull) at 4.9 MB instead of 30.8 MB.
RUN wget -qO /tmp/ci.tgz "https://github.com/lexiforest/curl-impersonate/releases/download/v2.1.0/curl-impersonate-v2.1.0.x86_64-linux-gnu.tar.gz" \
  && tar xzf /tmp/ci.tgz -C /usr/local/bin curl-impersonate \
  && chmod 0755 /usr/local/bin/curl-impersonate \
  && strip --strip-all /usr/local/bin/curl-impersonate \
  && rm -f /tmp/ci.tgz \
  && /usr/local/bin/curl-impersonate --version | head -1

# Staged inputs (see server/docker/build-rust-image.sh):
#   bin/scrybox-server        — cargo --release, strip=true, ~17 MB
#   lib/libonnxruntime.so.1   — MIT-licensed ORT dylib the Node image carries
#                               inside onnxruntime-node; Rust dlopens it via
#                               ORT_DYLIB_PATH (ort "load-dynamic"). Already
#                               symbol-stripped upstream (38 MB is real).
#   lib/libscryjpeg.so        — mozjpeg-4.1.5 static shim (bit-identical JPEG
#                               decode for the scan tensor path), SCRYBOX_JPEG_LIB.
COPY server/docker/bin/scrybox-server /payload/bin/scrybox-server
COPY server/docker/lib/libonnxruntime.so.1 /payload/ort/libonnxruntime.so.1
COPY server/docker/lib/libscryjpeg.so /payload/lib/libscryjpeg.so

# Build the final rootfs subset: every binary the runtime exec's or dlopen's
# plus its FULL ldd closure (paths preserved so PT_INTERP and the loader's
# search resolve verbatim under scratch), the NSS/resolv modules glibc
# dlopens at runtime for getpwnam("scrybox") and getaddrinfo, the static
# gosu + busybox (deliberately not ldd'd — no deps), the CA bundle, and
# /etc/passwd|group for gosu. A missing closure member FAILS the build.
RUN set -eu; \
    mkdir -p /staging; \
    ldd /payload/bin/scrybox-server /usr/local/bin/curl-impersonate \
        /payload/ort/libonnxruntime.so.1 /payload/lib/libscryjpeg.so > /ldd.txt 2>/dev/null; \
    if grep -q '=> not found' /ldd.txt; then \
      echo 'UNRESOLVED DEPS:' >&2; grep '=> not found' /ldd.txt >&2; exit 1; \
    fi; \
    awk '!/weak version|not a dynamic/ { \
           if ($0 ~ /^[[:space:]]*\/[^[:space:]]+:$/) next; \
           for (i = 1; i <= NF; i++) { p = $i; sub(/:$/, "", p); \
             if (p ~ /^\//) print p } \
         }' /ldd.txt > /staging.list; \
    printf '%s\n' \
      /lib/x86_64-linux-gnu/libnss_files.so.2 \
      /lib/x86_64-linux-gnu/libnss_dns.so.2 \
      /lib/x86_64-linux-gnu/libnss_compat.so.2 \
      /lib/x86_64-linux-gnu/libresolv.so.2 \
      >> /staging.list; \
    sort -u /staging.list | while read -r lib; do \
      [ -e "$lib" ] || { echo "MISSING LIB: $lib" >&2; exit 1; }; \
      mkdir -p "/staging$(dirname "$lib")"; \
      cp -p "$lib" "/staging$lib"; \
    done; \
    mkdir -p /staging/opt/ort/lib /staging/opt/lib /staging/usr/local/bin /staging/bin \
             /staging/etc/ssl/certs /staging/etc/ssl/private /staging/tmp; \
    cp -p /payload/bin/scrybox-server /staging/usr/local/bin/scrybox-server; \
    cp -p /payload/ort/libonnxruntime.so.1 /staging/opt/ort/lib/libonnxruntime.so.1; \
    cp -p /payload/lib/libscryjpeg.so /staging/opt/lib/libscryjpeg.so; \
    cp -p /usr/sbin/gosu /staging/usr/local/bin/gosu; \
    cp -p /usr/local/bin/curl-impersonate /staging/usr/local/bin/curl-impersonate; \
    cp -p /usr/bin/busybox /staging/bin/busybox; \
    for a in sh find chown mkdir echo cat ls pgrep; do ln -s busybox "/staging/bin/$a"; done; \
    cp -p /etc/ssl/certs/ca-certificates.crt /staging/etc/ssl/certs/ca-certificates.crt; \
    echo 'root:x:0:0:root:/root:/bin/sh' > /staging/etc/passwd; \
    echo 'scrybox:x:1000:1000:scrybox:/app:/bin/sh' >> /staging/etc/passwd; \
    echo 'root:x:0:' > /staging/etc/group; \
    echo 'scrybox:x:1000:' >> /staging/etc/group; \
    du -sm /staging

# =========================================
# Stage 3: final image — scratch, assembled only from the donor subset
# =========================================
FROM scratch
# Rootfs subset (loader, glibc + libstdc++/libgcc closure, NSS, static gosu
# and busybox, CA roots, /etc/passwd|group, the three payload binaries).
COPY --from=pkgroot /staging/ /
# Layout mirrors the Node image so an existing named volume at /app/database
# (bindarr.db, models/, ssl/, card-art/) drops in unchanged.
WORKDIR /app
# Shared JSON tables at the path the Node image used (/app/shared) — the
# crate reads them through SCRYBOX_SHARED_DIR. --chown bakes the uid-1000
# ownership the old `chown -R` layer cost 61 MB to produce.
COPY --chown=1000:1000 shared/ /app/shared/
COPY --chown=1000:1000 --from=frontend-builder /app/frontend/dist /app/frontend/dist
# entrypoint-rust.sh is LF in-tree (verified); --chmod bakes the exec bit
# (scratch has no RUN shell for sed/chmod).
COPY --chmod=755 server/docker/entrypoint-rust.sh /entrypoint.sh
# TOTORO mono: the local Scryfall engine is linked INTO scrybox-server (no
# scryfall-local sidecar). Its static portal (~256 KB) and the vendored set
# metadata (~430 KB: blocks.json, sets-meta.json, land_cycles.json — the
# copies the live sidecar actually serves from) ship read-only in the image;
# the bulk files live in the volume (see SCRYBOX_LSF_DATA_DIR below).
COPY --chown=1000:1000 local-scryfall/static/ /app/scryfall/static/
COPY --chown=1000:1000 local-scryfall/data/blocks.json local-scryfall/data/sets-meta.json local-scryfall/data/land_cycles.json /app/scryfall/data/
# In-process cardscan OCR assets (empty unless SCRYBOX_OCR_SRC was staged).
COPY server/docker/ocr/ /opt/ocr/

ENV PORT=3001 \
    SCRYBOX_BIND=0.0.0.0:3001 \
    SCRYBOX_NODE_UPSTREAM= \
    SCRYBOX_DB_PATH=/app/database/bindarr.db \
    SCRYBOX_STATIC_DIR=/app/frontend/dist \
    SCRYBOX_SHARED_DIR=/app/shared \
    CV_MODEL_DIR=/app/database/models \
    ORT_DYLIB_PATH=/opt/ort/lib/libonnxruntime.so.1 \
    SCRYBOX_JPEG_LIB=/opt/lib/libscryjpeg.so \
    SCRYBOX_OCR_MODEL_DIR=/opt/ocr \
    SCRYBOX_CARDSCAN_DATA=/opt/ocr \
    HTTPS_PORT=3443 \
    RUST_ROUTES=* \
    RUST_MIGRATIONS=true \
    RUST_JOBS=scryfall \
    SCRYBOX_LSF_DATA_DIR=/app/database/scryfall-data \
    SCRYBOX_LSF_STATIC_DIR=/app/scryfall/static \
    SCRYBOX_LSF_VENDORED_DIR=/app/scryfall/data \
    LOCAL_SCRYFALL_ENABLED=true \
    LOCAL_WEB_PORTAL_ENABLED=true
# The two ONNX models are NOT in the image (AGPL-3.0 vs MIT — operator
# fetches them into the volume, same policy as the Node image).
# TOTORO mono (local Scryfall engine in-process):
#   SCRYBOX_LSF_DATA_DIR   bulk data dir (default-cards / oracle-tags are
#                          fetched there on first boot and refreshed daily at
#                          05:00, SCRYBOX_LSF_REFRESH_AT; an existing sidecar
#                          /data dir — incl. all-cards.jsonl.gz and
#                          lang_map_full.json.gz, which are never downloaded —
#                          can be mounted here as-is).
#   LOCAL_SCRYFALL_ENABLED / LOCAL_WEB_PORTAL_ENABLED = true, matching the
#   production Node container's env, but LOCAL_SCRYFALL_URL and
#   SCRYBOX_SIDECAR_URL stay UNSET: unset = in-process engine; setting either
#   re-enables the HTTP path to an external engine (fallback only).
#   SCRYBOX_NODE_UPSTREAM stays empty: the Node-free image has no Node.
# NOTE: no USER directive on purpose — the container starts as root so
# entrypoint-rust.sh can adopt a foreign-owned /app/database volume, then
# gosu drops to uid 1000 (matching the Node image's `node` user) for the
# server itself.

EXPOSE 3001 3443

# busybox wget stands in for the slim-distro wget (Gate D names glibc,
# curl-impersonate and gosu; wget here is HEALTHCHECK duty only — NSS+CA are
# staged so getaddrinfo works).
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD ["/bin/busybox", "wget", "-qO-", "http://localhost:3001/api/health"]

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/local/bin/scrybox-server"]
